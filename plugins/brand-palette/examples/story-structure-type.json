       {"label": "Display", "size": "3rem", "weight": 600, "line": 1.1, "use": "heading"},
       {"label": "Body", "size": "15px", "weight": 400, "line": 1.4, "use": "body"},
       {"label": "Caption", "size": "0.75rem", "weight": 300, "line": 1.4, "use": "caption", "color": "muted", "caps": true}
     ]},
    {"id": "c", "name": "Hyperlegible", "character": "Readability first.",
